# Copy these values into private service configuration. Never commit a real session.
WEDDING_IDENTITY_KEY=example-agent
WEDDING_MCP_URL=https://wedding.example/mcp
WEDDING_SESSION_FILE=.local/example-agent-session.json
WEDDING_LISTENER_DB=.local/example-agent-listener.sqlite
WEDDING_WAIT_TIMEOUT_MS=25000

# queue: persist only; stdout: emit JSON batches; webhook: POST JSON batches.
WEDDING_WAKE_SINK=webhook
WEDDING_WAKE_WEBHOOK=https://agent-host.example/hooks/wedding
# Optional HMAC-SHA256 signature header: x-agent-wedding-signature
WEDDING_WAKE_SECRET=replace-in-private-configuration

# Optional override. Defaults already include phase, role cue, invitations,
# personal notifications, resync, terminal errors, left and closed.
# WEDDING_WAKE_KINDS=phase,pause,role_cue,photo_invitation,photo_duo_request,notification,resync,listener_error,left,closed
